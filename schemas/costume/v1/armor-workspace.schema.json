{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/TheArmoredGarage/Armorsmith-Documents/main/schemas/costume/v1/armor-workspace.schema.json",
  "title": "Costume version 1 armor-chunks workspace",
  "allOf": [
    {"$ref": "workspace.schema.json"},
    {
      "type": "object",
      "required": ["codec", "legacyLayout"],
      "properties": {
        "codec": {"const": "armor-chunks"},
        "legacyLayout": {
          "type": "array",
          "items": {
            "oneOf": [
              {"type": "string", "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"},
              {
                "type": "object",
                "required": ["asset"],
                "properties": {"asset": {"$ref": "common.schema.json#/$defs/id"}},
                "additionalProperties": true
              }
            ]
          }
        }
      }
    }
  ]
}
